# Copy to .env (which is git-ignored) and fill in. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# --- Supabase -----------------------------------------------------------------
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=

# The PUBLIC key: "publishable" (sb_publishable_...) or the older "anon" key.
# It is sent to browsers by design. Never put a secret / service_role key
# here; the server refuses to start with one, and no part of this app needs it.
SUPABASE_ANON_KEY=

# --- Where the vocabulary lives (optional) ------------------------------------
# "supabase" your Supabase project, with an account per person
# "mock"     built-in sample words kept in memory; contacts nothing
# Empty: "supabase" in a deployment or when SUPABASE_URL is set, otherwise
# "mock" (local development only). Nothing else is ever chosen for you.
DATA_MODE=

# --- Review behaviour (optional) ----------------------------------------------
# Each account stores its own time zone (Settings in the app). This is only the
# zone a new account starts with when its browser does not report one.
# Example: Asia/Ho_Chi_Minh
REVIEW_TIMEZONE=

# Saving is on. Set this to exactly "false" to freeze all changes on purpose:
# the app then shows everything and checks answers, but records nothing.
REVIEW_WRITES_ENABLED=

# --- AI assistance (optional; off when AI_API_KEY is empty) --------------------
# Smart Reader (Add vocabulary) and the Writing Challenge coach ask a model for
# a draft. The key stays on the server and is never handed to the browser.
# Any OpenAI-compatible provider works. See docs/ai-features.md.
AI_API_KEY=
# Defaults: Google Gemini's OpenAI-compatible endpoint, model gemini-2.5-flash.
AI_BASE_URL=
AI_MODEL=
# How long to wait for an answer, in ms (1000-28000). Default 20000.
AI_TIMEOUT_MS=

# --- Scripts (optional; each script asks when these are not set) --------------
# npm run supabase:import  - the account that will own the imported words
MIGRATION_EMAIL=
MIGRATION_PASSWORD=
# npm run supabase:verify  - A is a throwaway account; B is any other account
VERIFY_A_EMAIL=
VERIFY_A_PASSWORD=
VERIFY_B_EMAIL=
VERIFY_B_PASSWORD=

# --- Server (self-hosting only) -----------------------------------------------
PORT=8787
