# Copy to .env (which is git-ignored) and fill in. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# --- Notion -----------------------------------------------------------------
# Internal integration secret (https://www.notion.so/profile/integrations).
# Capabilities needed: "Read content", "Update content" and, to add words,
# "Insert content". Nothing else.
NOTION_API_KEY=

# The vocabulary database id: the 32-character id in the database URL.
NOTION_DATABASE_ID=

# Only needed if the database contains more than one data source.
NOTION_DATA_SOURCE_ID=

# --- Review behaviour -------------------------------------------------------
# IANA time zone that decides which calendar day is "today" for due dates.
# Required with Notion. Example: Asia/Ho_Chi_Minh
REVIEW_TIMEZONE=

# true lets the app change Notion: review answers, new words, edits, deletes.
# Anything else makes the whole app read-only.
REVIEW_WRITES_ENABLED=false

# "mock" serves built-in sample words and never contacts Notion.
# Defaults to "notion" when NOTION_API_KEY is set, otherwise "mock" (dev only).
DATA_MODE=

# --- Access -----------------------------------------------------------------
# Optional passphrase for the app. In production the server refuses to run
# with neither a passphrase nor ALLOW_UNAUTHENTICATED_ACCESS=true, so that an
# open deployment is always a deliberate choice.
APP_ACCESS_PASSWORD=
ALLOW_UNAUTHENTICATED_ACCESS=false

# --- Server (self-hosting only) ---------------------------------------------
PORT=8787
