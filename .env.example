# Copy to .env (which is git-ignored) and fill in. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# --- Where the vocabulary lives ----------------------------------------------
# "notion"   the Notion database (the original setup)
# "supabase" Supabase, with an account per person (see docs/supabase-migration.md)
# "mock"     built-in sample words; contacts nothing
# Empty: "notion" when NOTION_API_KEY is set, otherwise "mock" (development only).
# Supabase is used only when it is named here, and is never fallen back from.
DATA_MODE=

# --- Supabase (DATA_MODE=supabase) --------------------------------------------
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=

# The PUBLIC key: "anon" or "publishable". It is sent to browsers by design.
# Never put the service_role / secret key here; the server refuses to start
# with one, and no part of this app needs it.
SUPABASE_ANON_KEY=

# --- Notion (DATA_MODE=notion) ------------------------------------------------
# Internal integration secret (https://www.notion.so/profile/integrations).
# Capabilities needed: "Read content", "Update content" and, to add words,
# "Insert content". Nothing else.
NOTION_API_KEY=

# The vocabulary database id: the 32-character id in the database URL.
NOTION_DATABASE_ID=

# Only needed if the database contains more than one data source.
NOTION_DATA_SOURCE_ID=

# --- Review behaviour ---------------------------------------------------------
# IANA time zone that decides which calendar day is "today" for due dates.
# Notion: required. Example: Asia/Ho_Chi_Minh
# Supabase: optional; each account stores its own, and this is only the zone a
# new account starts with when its browser does not report one.
REVIEW_TIMEZONE=

# Notion: true lets the app change Notion (reviews, new words, edits, deletes);
# anything else makes the whole app read-only.
# Supabase: saving is on unless this is exactly "false", which freezes changes.
REVIEW_WRITES_ENABLED=false

# --- Access (Notion and sample data only) -------------------------------------
# Optional shared passphrase. In production the server refuses to run with
# neither a passphrase nor ALLOW_UNAUTHENTICATED_ACCESS=true, so that an open
# deployment is always a deliberate choice. With Supabase these are ignored:
# everyone signs in to their own account.
APP_ACCESS_PASSWORD=
ALLOW_UNAUTHENTICATED_ACCESS=false

# --- Scripts (optional; each script asks when these are not set) --------------
# npm run supabase:import  - the account that will own the imported words
MIGRATION_EMAIL=
MIGRATION_PASSWORD=
# npm run supabase:verify  - two throwaway accounts
VERIFY_A_EMAIL=
VERIFY_A_PASSWORD=
VERIFY_B_EMAIL=
VERIFY_B_PASSWORD=

# --- Server (self-hosting only) -----------------------------------------------
PORT=8787
